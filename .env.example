# Contact form (src/actions/index.ts). Copy to .env for local dev, and set
# the same values in the Vercel project's Environment Variables.
# Without RESEND_API_KEY the site still builds — the form just reports that
# email delivery isn't configured.

# From https://resend.com/api-keys
RESEND_API_KEY=

# Where form submissions are delivered. Defaults to `contact.email` in
# src/data/contact.ts when unset.
CONTACT_TO_EMAIL=

# Sender address. Defaults to Resend's sandbox sender (onboarding@resend.dev),
# which needs no domain verification but can only deliver to the address that
# owns the Resend account. To send from your own domain, verify it in Resend
# and set something like hello@ausdotsn50.dev here.
CONTACT_FROM_EMAIL=
