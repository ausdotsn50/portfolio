---
// Presentational vinyl record (inline SVG, no framework).
// The disc uses fixed dark values so it reads as a black record in both
// Day/Night themes; only the label uses the warm accent tokens.
interface Props {
  size?: number;
  label?: string;
  side?: string;
  class?: string;
}

const { size = 260, label = 'LATE SESSIONS', side = 'SWE', class: className = '' } = Astro.props;
---

<svg
  class:list={['vinyl-disc origin-center block', className]}
  width={size}
  height={size}
  viewBox="0 0 200 200"
  role="img"
  aria-label={`${label} record`}
>
  <defs>
    <radialGradient id="vinyl-body" cx="50%" cy="50%">
      <stop offset="0%" stop-color="#2b211a"></stop>
      <stop offset="65%" stop-color="#16110d"></stop>
      <stop offset="100%" stop-color="#0a0806"></stop>
    </radialGradient>
    <radialGradient id="vinyl-label" cx="42%" cy="38%">
      <stop offset="0%" stop-color="var(--mustard)"></stop>
      <stop offset="100%" stop-color="var(--burnt-orange)"></stop>
    </radialGradient>
    <path id="vinyl-label-arc" d="M 71,100 A 29,29 0 0 1 129,100" fill="none"></path>
  </defs>

  <!-- Disc body -->
  <circle cx="100" cy="100" r="92" fill="url(#vinyl-body)"></circle>

  <!-- Groove rings -->
  {
    [86, 78, 70, 62, 54, 47, 41].map((r) => (
      <circle
        cx="100"
        cy="100"
        r={r}
        fill="none"
        stroke="rgba(255,240,220,0.05)"
        stroke-width="0.5"
      />
    ))
  }
  <!-- Sheen highlight -->
  <circle cx="100" cy="100" r="92" fill="none" stroke="rgba(255,240,220,0.06)" stroke-width="1" />

  <!-- Label -->
  <circle cx="100" cy="100" r="38" fill="url(#vinyl-label)" />
  <circle cx="100" cy="100" r="37" fill="none" stroke="rgba(20,12,6,0.25)" stroke-width="0.75" />

  <!-- Curved title + side marking (dark ink for contrast on the gold label) -->
  <text fill="#241812" font-family="var(--font-mono)" font-size="7" letter-spacing="1.5">
    <textPath href="#vinyl-label-arc" startOffset="50%" text-anchor="middle">{label}</textPath>
  </text>
  <text
    x="100"
    y="118"
    text-anchor="middle"
    fill="#241812"
    font-family="var(--font-mono)"
    font-size="5"
    letter-spacing="1"
    opacity="0.75">{side}</text
  >

  <!-- Spindle hole -->
  <circle cx="100" cy="100" r="4" fill="#0a0806"></circle>
</svg>
