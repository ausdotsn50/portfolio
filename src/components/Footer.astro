---
import Mail from 'lucide-astro/Mail';
import Github from 'lucide-astro/Github';
import Linkedin from 'lucide-astro/Linkedin';
import Facebook from 'lucide-astro/Facebook';
import { contact, socialLinks } from '../data/contact';

// Maps a SocialLink's `icon` name to its component, so adding a platform is
// a data change in contact.ts rather than a markup change here.
const SOCIAL_ICONS = {
  github: Github,
  linkedin: Linkedin,
  facebook: Facebook,
};

// Footer — pulled from Figma, except the right-hand side: the design shows a
// live clock ("18:38:22 EST"), which would either be frozen at build time in
// the wrong timezone or need a client-side ticking script. Swapped for a
// build-time dynamic copyright year instead, per the standing convention.
const year = new Date().getFullYear();
---

{/* Padding sits on the inner max-w-content wrapper (not the <footer>) so the
    text lines up with every section above, which uses the same
    `mx-auto max-w-content px-6` container. The border stays on the <footer>
    so it still spans the full viewport width. Both text halves are flex-1
    and the icon row is shrink-0, so the icons stay centred no matter how
    the two text groups differ in width. */}
<footer class="border-t border-rule">
  <div
    class="mx-auto flex max-w-content flex-col items-center gap-4 px-6 py-6 text-center sm:flex-row sm:gap-6 sm:text-left"
  >
    <div
      class="flex flex-1 items-center justify-center gap-3 font-ui text-micro text-sepia sm:justify-start"
    >
      <span>{contact.name}</span>
      <span>&middot;</span>
      <span>{contact.location}</span>
    </div>

    {/* Quick links. Icon-only, so each one carries an aria-label — the icons
        themselves are decorative. The mail link doubles as the contact
        form's fallback when JS is unavailable. */}
    <ul class="flex shrink-0 items-center gap-2">
      {
        socialLinks.map((link) => {
          const Icon = SOCIAL_ICONS[link.icon];
          return (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={link.label}
                title={link.label}
                class="grid h-9 w-9 place-items-center rounded-full border border-rule text-espresso-soft transition-colors hover:border-accent-ink hover:text-accent-ink"
              >
                <Icon class="h-4 w-4" aria-hidden="true" />
              </a>
            </li>
          );
        })
      }
    </ul>

    <div
      class="flex flex-1 items-center justify-center gap-3 font-ui text-micro text-sepia sm:justify-end"
    >
      <span>&copy; {year} ausdotsn50</span>
      <span>&middot;</span>
      <span class="font-display text-small italic">All originals</span>
    </div>
  </div>
</footer>
