---
import { Icon } from 'astro-icon/components';
// A tech shown as a mini vinyl record: black disc + warm label with the tech
// icon printed on it, name underneath. Spins gently on hover.
interface Props {
  name: string;
  icon: string;
}
const { name, icon } = Astro.props;
---

<figure class="mini-disc group flex w-[76px] flex-col items-center gap-2 cursor-pointer">
  <div class="disc-face relative h-[52px] w-[52px] drop-shadow-md">
    <svg viewBox="0 0 100 100" class="h-full w-full" aria-hidden="true">
      <defs>
        <radialGradient id="md-body" cx="50%" cy="50%">
          <stop offset="0%" stop-color="#2b211a"></stop>
          <stop offset="70%" stop-color="#16110d"></stop>
          <stop offset="100%" stop-color="#0a0806"></stop>
        </radialGradient>
        <radialGradient id="md-label" cx="42%" cy="38%">
          <stop offset="0%" stop-color="#d9b057"></stop>
          <stop offset="100%" stop-color="#d97843"></stop>
        </radialGradient>
      </defs>
      <circle cx="50" cy="50" r="48" fill="url(#md-body)" />
      <circle cx="50" cy="50" r="48" fill="none" stroke="rgba(255,240,220,0.12)" stroke-width="1" />
      {
        [42, 36, 30].map((r) => (
          <circle cx="50" cy="50" r={r} fill="none" stroke="rgba(255,240,220,0.06)" stroke-width="0.5" />
        ))
      }
      <circle cx="50" cy="50" r="20" fill="url(#md-label)"></circle>
      <circle cx="50" cy="50" r="19" fill="none" stroke="rgba(20,12,6,0.25)" stroke-width="0.75"
      ></circle>
    </svg>
    <span class="pointer-events-none absolute inset-0 grid place-items-center">
      <Icon name={icon} class="text-[12px] text-[#241812]" aria-hidden="true" />
    </span>
  </div>
  <figcaption
    class="text-center font-mono text-[10px] uppercase tracking-[0.1em] text-espresso-soft transition-colors group-hover:text-espresso"
  >
    {name}
  </figcaption>
</figure>

<style>
  .disc-face {
    transform-origin: center;
    transition: transform 300ms ease;
  }
  .mini-disc:hover .disc-face {
    animation: disc-spin 5s linear infinite;
  }

  @keyframes disc-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mini-disc:hover .disc-face {
      animation: none;
      transform: scale(1.06);
    }
  }
</style>
