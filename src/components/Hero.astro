---
import NowPlaying from './NowPlaying.astro';
import { Icon } from 'astro-icon/components';

---
<section id="hero" class="relative overflow-hidden">
  <Icon
    name="mdi-light:music"
    aria-hidden="true"
    class="pointer-events-none absolute -left-32 -top-28 hidden -rotate-12 text-sepia opacity-[0.07] lg:block"
    width="460"
    height="460"
  />

  <div class="relative z-10 mx-auto max-w-content px-6 py-16 md:py-24">
    <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-12">
      <!-- Left: intro -->
      <div class="lg:col-span-7">

        <h1 class="font-display font-medium leading-[1.02]">
          <span class="block text-[clamp(3.5rem,9vw,6rem)] text-espresso-soft [text-wrap:balance]">Angela Denise</span>
          <span class="block text-[clamp(3.5rem,9vw,6rem)] italic text-burnt-orange">ausdotsn50</span>
        </h1>

        <p class="mt-6 max-w-md font-body text-body-large text-espresso">
          Building full-stack web and mobile apps for real communities. From local businesses to
          governments and NGOs, I build clean, dependable software with purpose.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="#project"
            class="inline-flex items-center rounded-lg bg-gradient-to-br from-burnt-orange to-mustard px-6 py-3 font-ui text-small font-medium text-[#1c1410] transition-opacity hover:opacity-90"
          >
            View the Record
          </a>
          <a
            href="#about"
            class="inline-flex items-center rounded-lg border border-espresso-soft px-6 py-3 font-ui text-small font-medium text-espresso transition-colors hover:bg-cream-deep"
          >
            Liner Notes
          </a>
        </div>
      </div>

      <!-- Right: now-playing vinyl player -->
      <div class="lg:col-span-5">
        <NowPlaying discLabel="ausdotsn50" />
      </div>
    </div>
  </div>
</section>
