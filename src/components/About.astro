---
import fs from 'node:fs';
import path from 'node:path';
import Music from 'lucide-astro/Music';
import ChevronLeft from 'lucide-astro/ChevronLeft';
import ChevronRight from 'lucide-astro/ChevronRight';

// About — Figma layout (music-glyph eyebrow + rule, "About" heading, bio) with
// a portrait carousel framed as album art in the right column.
//
// Photos are read dynamically at build time from public/about-carousel/. Drop
// any `.webp` in there and it shows up — no code changes needed. The filename
// IS the caption: it's shown verbatim with hyphens turned into spaces, so the
// exact wording, capitalisation, and punctuation come straight from the name
// (e.g. `Playing-Guitar-at-Caba-Beach.webp` → "Playing Guitar at Caba Beach").
// An optional leading `NN-` (e.g. `01-`) controls order and is stripped from
// the caption. A consistent warm duotone overlay unifies photos with different
// hues; it eases off on hover.
const CAROUSEL_DIR = 'about-carousel';
const carouselPath = path.join(process.cwd(), 'public', CAROUSEL_DIR);

// Filename → caption: drop the extension and any `NN-` ordering prefix, then
// turn hyphens/underscores into spaces while preserving the author's casing.
const toCaption = (file: string): string =>
  file
    .replace(/\.webp$/i, '')
    .replace(/^\d+[-_]/, '')
    .replace(/[-_]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const files = fs.existsSync(carouselPath)
  ? fs
      .readdirSync(carouselPath)
      .filter((f) => /\.webp$/i.test(f))
      .sort((a, b) => a.localeCompare(b))
  : [];

const photos = files.map((file) => {
  const caption = toCaption(file);
  return {
    // encodeURIComponent makes spaces valid in the URL; it leaves apostrophes
    // untouched, so escape those too (%27) or they'd close the CSS url('…')
    // string early below.
    src: `/${CAROUSEL_DIR}/${encodeURIComponent(file).replace(/'/g, '%27')}`,
    alt: `Angela Denise Almazan — ${caption}`,
    caption,
  };
});
---

<section id="about">
  <div class="mx-auto max-w-content px-6 py-16 md:py-24">
    <!-- Section label -->
    <div class="flex items-center gap-3">
      <Music class="h-4 w-4 text-accent-ink" aria-hidden="true" />
      <span class="whitespace-nowrap font-ui text-micro uppercase tracking-[0.25em] text-espresso-soft">
        Liner Notes
      </span>
      <span class="h-px min-w-0 flex-1 bg-rule"></span>
    </div>

    <div class="mt-8 grid grid-cols-1 items-start gap-y-10 gap-x-8 md:grid-cols-12 lg:gap-16">
      <!-- Bio -->
      <div class="md:col-span-6 lg:col-span-7">
        <h2
          class="font-display text-[clamp(2.5rem,5vw,3.35rem)] font-semibold leading-none text-espresso"
        >
          About
        </h2>

        <div class="mt-10 max-w-2xl space-y-6">
          <p class="font-body text-body-large leading-[1.8] text-espresso-soft">
            I'm Angela Denise Almazan, a fourth-year Computer Science student at the University of the
            Philippines Tacloban. I ship full-stack web and mobile apps for real communities; most
            recently contributing to BetterAllen, an open-source site for the LGU of Allen, and
            leading the development of GDFI's website, a local NGO. From local businesses to
            governments and NGOs, I build clean, dependable software with purpose.
          </p>
          <p class="font-body text-body-large leading-[1.8] text-espresso-soft">
            Outside Computer Science, my interests span making and consuming music, catching a good
            comedy set, and playing — whether computer games or physical sports. On the professional side, I have
            years of experience working for a Digital Marketing Agency and worked freelance as a
            Multimedia Editor.
          </p>
        </div>
      </div>

      <!-- Portrait carousel as album art -->
      <div class="md:col-span-6 md:self-center lg:col-span-5">
        <figure class="mx-auto w-full max-w-sm" data-carousel>
          <div
            class="group relative aspect-square overflow-hidden rounded-xl border border-rule shadow-xl"
          >
            <!-- Photo slides: warm duotone at rest, true colour on hover -->
            <div
              class="absolute inset-0 transition-[filter] duration-500 [filter:sepia(0.32)_saturate(0.9)_contrast(1.05)_brightness(0.96)] group-hover:[filter:none]"
            >
              {
                photos.map((p, i) => (
                  <div
                    data-slide
                    data-caption={p.caption}
                    data-active={i === 0 ? '' : undefined}
                    role="img"
                    aria-label={p.alt}
                    class="absolute inset-0 bg-cover bg-center opacity-0 transition-opacity duration-700 data-[active]:opacity-100"
                    style={`background-image:url('${p.src}')`}
                  />
                ))
              }
            </div>

            <!-- Warm blend tint (eases off on hover) -->
            <div
              class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[rgba(194,90,31,0.28)] to-[rgba(20,12,6,0.42)] mix-blend-multiply transition-opacity duration-500 group-hover:opacity-0"
            >
            </div>
            <!-- Bottom vignette for caption/dot legibility -->
            <div
              class="pointer-events-none absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-[rgba(10,8,6,0.55)] to-transparent"
            >
            </div>

            {
              photos.length > 1 && (
                <Fragment>

                  <button
                    data-prev
                    type="button"
                    aria-label="Previous photo"
                    class="absolute left-2 top-1/2 grid h-9 w-9 -translate-y-1/2 place-items-center rounded-full bg-[rgba(10,8,6,0.45)] text-white backdrop-blur-sm transition hover:bg-[rgba(10,8,6,0.72)]"
                  >
                    <ChevronLeft class="h-[18px] w-[18px]" aria-hidden="true" />
                  </button>

                  <button
                    data-next
                    type="button"
                    aria-label="Next photo"
                    class="absolute right-2 top-1/2 grid h-9 w-9 -translate-y-1/2 place-items-center rounded-full bg-[rgba(10,8,6,0.45)] text-white backdrop-blur-sm transition hover:bg-[rgba(10,8,6,0.72)]"
                  >
                    <ChevronRight class="h-[18px] w-[18px]" aria-hidden="true" />
                  </button>

                  <div class="absolute bottom-3 left-1/2 flex -translate-x-1/2 items-center gap-1.5">
                    {photos.map((_, i) => (
                      <button
                        data-dot
                        type="button"
                        aria-label={`Go to photo ${i + 1}`}
                        aria-current={i === 0 ? 'true' : 'false'}
                        data-active={i === 0 ? '' : undefined}
                        class="h-1.5 w-1.5 rounded-full bg-white/50 transition-all duration-300 data-[active]:w-4 data-[active]:bg-white"
                      />
                    ))}
                  </div>

                </Fragment>
              )
            }
          </div>

          <figcaption
            class="mt-3 flex items-center justify-between font-body text-small tracking-[0.15em] text-espresso-soft"
          >
            <span class="italic" data-caption-display>{photos[0].caption}</span>
            <span class="text-sepia"><span data-index>1</span> / {photos.length}</span>
          </figcaption>
          
        </figure>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/photo-carousel.ts';
</script>
