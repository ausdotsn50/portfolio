---
import Music from 'lucide-astro/Music';
import CircleCheck from 'lucide-astro/CircleCheck';
import CircleAlert from 'lucide-astro/CircleAlert';
import LoaderCircle from 'lucide-astro/LoaderCircle';

// Outro — closing "Let's make something together" CTA, pulled from Figma.
// Same section-label + heading conventions as every other section. No
// section-level background — every section relies on the shared html/body
// background + ambient glow (global.css) so there are no seams between them.
---

<section id="contact" class="relative overflow-hidden">
  <div class="relative mx-auto max-w-content px-6 py-16 md:py-24">
    <!-- Section label -->
    <div class="flex items-center gap-3">
      <Music class="h-4 w-4 text-accent-ink" aria-hidden="true" />
      <span class="whitespace-nowrap font-ui text-micro uppercase tracking-[0.25em] text-espresso-soft">
        Outro
      </span>
      <span class="h-px min-w-0 flex-1 bg-rule"></span>
    </div>

    <div class="mt-8 grid grid-cols-1 items-start gap-y-10 gap-x-8 md:grid-cols-12 lg:gap-16">
      <!-- Left: the pitch, plus the direct-contact links. These live here
           rather than under the form so the heading's column isn't left as
           dead space once the form fills the right-hand side. -->
      <div class="md:col-span-6 lg:col-span-7">
        <h2 class="font-display text-expresso text-[clamp(2.5rem,7vw,5.5rem)] font-semibold leading-[1.05] text-espresso">
          <span class="block">Let's ship</span>
          <span class="block italic text-burnt-orange">software</span>
          <span class="block">that matters.</span>
        </h2>

        <p class="mt-8 font-body text-body-large leading-[1.8] text-espresso-soft md:max-w-[30rem]">
          Open to full-time roles, contract work, and the occasional side project.
          If you're building something for local businesses, governments, or communities
          that need it — I'd love to be part of it.
        </p>
      </div>

      <!-- Right: the form and its call to action -->
      <div class="md:col-span-6 md:pt-2 lg:col-span-5">
        <p class="font-ui font-semibold text-micro uppercase tracking-[0.2em] text-sepia">
          Send a message
        </p>
        <p class="mt-2 font-body text-body leading-[1.7] text-espresso-soft">
          Have a project in mind? Tell me about it and I'll get back to you.
        </p>

        {/* Contact form — posts to the sendMessage action (src/actions/).
            Requires JS; the mail quick-link is the fallback. */}
        <form data-contact-form class="mt-5" novalidate>
          {/* Honeypot: off-screen and hidden from assistive tech, so only
              bots ever fill it. */}
          <div class="absolute left-[-9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
            <label>
              Website
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>
          <input type="hidden" name="startedAt" data-started-at />

          {/* Each field has an error slot beneath it, linked via
              aria-describedby so screen readers read the message when the
              field is focused. Slots are <span class="block">, not <p> —
              a <p> isn't valid inside a <label>. `empty:hidden` keeps an
              empty slot from adding stray spacing. */}
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="font-ui text-micro uppercase tracking-[0.15em] text-sepia">Name</span>
              <input
                type="text"
                name="name"
                required
                autocomplete="name"
                aria-describedby="contact-name-error"
                class="mt-1.5 w-full rounded-lg border border-rule bg-cream-deep px-3 py-2.5 font-body text-body text-espresso placeholder:text-sepia focus:border-accent-ink focus:outline-none focus:ring-1 focus:ring-accent-ink aria-[invalid=true]:border-burnt-orange"
              />
              <span
                id="contact-name-error"
                data-field-error="name"
                class="mt-1.5 block font-body text-small text-accent-ink empty:hidden"
              ></span>
            </label>

            <label class="block">
              <span class="font-ui text-micro uppercase tracking-[0.15em] text-sepia">Email</span>
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                aria-describedby="contact-email-error"
                class="mt-1.5 w-full rounded-lg border border-rule bg-cream-deep px-3 py-2.5 font-body text-body text-espresso placeholder:text-sepia focus:border-accent-ink focus:outline-none focus:ring-1 focus:ring-accent-ink aria-[invalid=true]:border-burnt-orange"
              />
              <span
                id="contact-email-error"
                data-field-error="email"
                class="mt-1.5 block font-body text-small text-accent-ink empty:hidden"
              ></span>
            </label>
          </div>

          <label class="mt-4 block">
            <span class="font-ui text-micro uppercase tracking-[0.15em] text-sepia">Message</span>
            <textarea
              name="message"
              rows="4"
              required
              aria-describedby="contact-message-error"
              class="mt-1.5 w-full resize-y rounded-lg border border-rule bg-cream-deep px-3 py-2.5 font-body text-body text-espresso placeholder:text-sepia focus:border-accent-ink focus:outline-none focus:ring-1 focus:ring-accent-ink aria-[invalid=true]:border-burnt-orange"
            ></textarea>
            <span
              id="contact-message-error"
              data-field-error="message"
              class="mt-1.5 block font-body text-small text-accent-ink empty:hidden"
            ></span>
          </label>

          {/* Full-width: every field above spans the column, so a full-width
              button closes the form off rather than leaving a stub on the
              left. The spinner shows while the button is disabled (sending). */}
          <button
            type="submit"
            class="group/submit mt-6 flex w-full items-center justify-center gap-2 rounded-lg bg-gradient-to-br from-burnt-orange to-mustard px-6 py-3.5 font-ui text-small font-medium text-[#1c1410] transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-70"
          >
            <LoaderCircle
              class="hidden h-4 w-4 animate-spin group-disabled/submit:block motion-reduce:animate-none"
              aria-hidden="true"
            />
            <span data-submit-label>Send message</span>
          </button>

          {/* Status banner, below the button so a message appearing never
              shifts the button under the pointer mid-retry. Always in the DOM
              (never display:none) so screen readers reliably announce it; it
              has no footprint until data-state is set. The icon marks success
              vs error so the difference isn't carried by colour alone. */}
          <div
            data-form-status
            role="status"
            aria-live="polite"
            class="form-status font-body text-small leading-relaxed"
          >
            <span class="form-status-icon" data-icon="success" aria-hidden="true">
              <CircleCheck class="h-[18px] w-[18px]" />
            </span>
            <span class="form-status-icon" data-icon="error" aria-hidden="true">
              <CircleAlert class="h-[18px] w-[18px]" />
            </span>
            <span data-form-status-text></span>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/contact-form.ts';
</script>

<style>
  /* Tints use color-mix() on the palette variables rather than Tailwind's
     `token/opacity` syntax, which silently generates no CSS for this
     project's var()-based colours. */
  .form-status {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .form-status[data-state] {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid;
    border-radius: 0.5rem;
    color: var(--espresso);
  }

  .form-status[data-state='success'] {
    border-color: color-mix(in srgb, var(--mustard) 45%, transparent);
    background: color-mix(in srgb, var(--mustard) 10%, transparent);
  }

  .form-status[data-state='error'] {
    border-color: color-mix(in srgb, var(--burnt-orange) 55%, transparent);
    background: color-mix(in srgb, var(--burnt-orange) 10%, transparent);
  }

  .form-status-icon {
    display: none;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .form-status[data-state='success'] [data-icon='success'] {
    display: block;
    color: var(--mustard);
  }

  .form-status[data-state='error'] [data-icon='error'] {
    display: block;
    color: var(--burnt-orange);
  }
</style>
