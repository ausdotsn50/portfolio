---
import fs from 'node:fs';
import path from 'node:path';
import Music from 'lucide-astro/Music';
import MiniDisc from './MiniDisc.astro';
import { stack } from '../data/stack';

// Icon slug is the lowercased, space-stripped tech name (e.g. "VS Code" ->
// "vscode"), falling back to no icon when src/icons/ has no matching file —
// same convention as the project cards' tech stack.
const ICONS_DIR = path.join(process.cwd(), 'src/icons');
const toIconSlug = (name: string) => name.toLowerCase().replace(/\s+/g, '');
const iconFor = (name: string) => {
  const slug = toIconSlug(name);
  return fs.existsSync(path.join(ICONS_DIR, `${slug}.svg`)) ? slug : undefined;
};
---

<section id="stack">
  <div class="mx-auto max-w-content px-6 py-16 md:py-24">
    <!-- Section label -->
    <div class="flex items-center gap-3">
      <Music class="h-4 w-4 text-accent-ink" aria-hidden="true" />
      <span class="whitespace-nowrap font-ui text-micro uppercase tracking-[0.25em] text-espresso-soft">
        Signal Chain
      </span>
      <span class="h-px min-w-0 flex-1 bg-rule"></span>
    </div>

    <h2
      class="mt-6 font-display text-[clamp(2.5rem,5vw,3.35rem)] font-semibold leading-none text-espresso"
    >
      Stack
    </h2>
    <p class="mt-4 font-body text-body-large leading-[1.7] text-espresso-soft">
      The kit I reach for — a crate of records, one per tool. Hover to give any a spin.
    </p>

    <!-- Crate: categories of mini discs -->
    <div class="mt-12 space-y-10">
      {
        stack.map((category) => (
          <div>
            <div class="flex items-center gap-3">
              <span class="whitespace-nowrap font-mono text-micro uppercase tracking-[0.2em] text-accent-ink">
                {category.name}
              </span>
              <span class="h-px min-w-0 flex-1 bg-rule" />
            </div>
            <div class="mt-6 flex flex-wrap gap-x-8 gap-y-8">
              {category.items.map((tech) => (
                <MiniDisc name={tech} icon={iconFor(tech)} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
